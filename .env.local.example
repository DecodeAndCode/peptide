# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLMs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# Email
RESEND_API_KEY=

# Rate Limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPPGO_TEST_MODE=true
SUPPGO_TEST_MODE_PROMPT_EXECUTIONS=

# Webflow OAuth
# Create a Webflow app in Workspace settings > Apps & Integrations > App Development.
WEBFLOW_OAUTH_CLIENT_ID=
WEBFLOW_OAUTH_CLIENT_SECRET=

# Integration token encryption
# Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

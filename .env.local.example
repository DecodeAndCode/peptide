# Supabase

NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=



# LLMs

OPENAI_API_KEY=

ANTHROPIC_API_KEY=

# Analysis cycles use Perplexity unless you skip it in dev (see SUPPGO_CYCLE_SKIP_PERPLEXITY).

# Influencer matching uses Perplexity by default (set PERPLEXITY_API_KEY).

# Opt into legacy OpenAI + SocialFetch discovery with SUPPGO_INFLUENCER_USE_SOCIALFETCH_DISCOVERY=true.

# For Perplexity troubleshooting, see logs `[perplexity]` (HTTP status + trimmed error body).

PERPLEXITY_API_KEY=

# Optional. Perplexity API model slug (default: sonar-pro). Set if your account uses a different name.

PERPLEXITY_API_MODEL=



# Email

RESEND_API_KEY=



# Rate Limiting

UPSTASH_REDIS_REST_URL=

UPSTASH_REDIS_REST_TOKEN=



# App

NEXT_PUBLIC_APP_URL=http://localhost:3000

SUPPGO_TEST_MODE=true

SUPPGO_TEST_MODE_PROMPT_EXECUTIONS=

SUPPGO_TEST_MODE_FORCE_CATEGORY_COVERAGE=true

# Dev only: when true and NODE_ENV is not production, analysis cycles omit Perplexity model

# (`perplexity-sonar-pro`) so Pro-tier cycles can finish without a working Perplexity key.

# Influencer discovery still calls Perplexity unless you enable the legacy SocialFetch path below.

SUPPGO_CYCLE_SKIP_PERPLEXITY=



# Influencer discovery: default Perplexity (no SocialFetch). Set true to use OpenAI + SocialFetch instead.

SUPPGO_INFLUENCER_USE_SOCIALFETCH_DISCOVERY=

# Legacy inverse flag: explicitly "false" on SUPPGO_INFLUENCER_USE_PERPLEXITY also forces SocialFetch discovery.

SUPPGO_INFLUENCER_USE_PERPLEXITY=

# Optional: after Perplexity suggests creators, re-check each handle + follower floor via SocialFetch (requires SOCIALFETCH_API_KEY; uses API credits).

SUPPGO_INFLUENCER_VERIFY_WITH_SOCIALFETCH=

# Optional tuning for SocialFetch path only (ignored when using default Perplexity discovery).

INFLUENCER_PROVIDER_MODE=current_only

# Each verified profile lookup spends SocialFetch credits; free tiers exhaust quickly on “Refresh”.

# If you hit HTTP 402/403/429, top up credits or pause refreshes. See toast + server `[socialfetch]` logs.

SOCIALFETCH_API_KEY=

# Optional: use only the JSON pool (SocialFetch path): lib/influencers/data/static-influencer-handles.json

SUPPGO_INFLUENCER_USE_STATIC_HANDLE_POOL=

# Cap SocialFetch billed lookups per influencer refresh (default 24). Sequential; stops sooner if enough verifies.

SUPPGO_INFLUENCER_SF_MAX_LOOKUPS=

# Stop once this many creators pass follower + profile checks (default 8).

SUPPGO_INFLUENCER_SF_STOP_AFTER_VERIFIED=



# Webflow OAuth
# Create a Webflow app in Workspace settings > Apps & Integrations > App Development.
WEBFLOW_OAUTH_CLIENT_ID=
WEBFLOW_OAUTH_CLIENT_SECRET=

# Shopify (custom-app / Admin API token path — no OAuth)
# Users paste a shop domain + Admin API access token (shpat_...) in Settings.
# Required scopes on the custom app: read_products, write_products,
# read_content, write_content. No env vars needed here.

# Integration token encryption (used for Webflow + Shopify + any future OAuth provider)
# Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# Dry-run mode for CMS deployments (Webflow / Shopify): when "1", skips real API calls
# and returns a synthetic deployment result. Useful for local testing without a real
# provider account. Ignored in production unless SUPPGO_ALLOW_DRY_RUN_PROD=1 is also set.
SUPPGO_CMS_DRY_RUN=
SUPPGO_ALLOW_DRY_RUN_PROD=

